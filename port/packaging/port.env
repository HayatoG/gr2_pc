# Port profile read by the packaging scripts and the CI: one file per port, same keys everywhere.
PORT_NAME="Gravity Rush 2"          # executable, window and menu entry name
PORT_SLUG="gr2"                     # package prefix: <slug>-linux-x86_64.tar.gz, <slug>-windows-x86_64.zip
PORT_LAUNCHER="gr2_launcher_qt.py"            # port/launcher/<file>: the default launcher (Qt Quick), frozen with PyInstaller
PORT_LAUNCHER_CLASSIC="gr2_launcher.py"       # port/launcher/<file>: the Tk launcher, shipped as "$PORT_NAME (classic)"
PORT_QT_PACKAGE="PySide6-Essentials==6.12.0"  # pinned for the package (launcher/qt/requirements.txt says >=6.7)
PORT_ICON="gr2"                     # port/launcher/<icon>.png and .ico (original art, never the game's)
PORT_TITLE_ID="CUSA03694"
